# ==============================================================================
# Supabase PostgreSQL Configuration
# ==============================================================================
# Obtain your database credentials from:
# Supabase Dashboard -> Project Settings -> Database -> Connection parameters

# JDBC URL (Direct connection on port 5432 or connection pooler on port 6543)
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Database Username (default is postgres, or postgres.<project-ref> for connection pooler)
SUPABASE_DB_USER=postgres

# Database Password (set when you created the Supabase project)
SUPABASE_DB_PASSWORD=your_database_password

# Spring Active Profile:
# - Set to 'supabase' to connect to your live Supabase Postgres database.
# - Set to 'dev' to run with the zero-config local H2 in-memory database with PostgreSQL compatibility.
SPRING_PROFILES_ACTIVE=supabase
